# Copy to `.env.test` before running tests.
# `.env.test` is gitignored so each dev sets their own DB credentials.
#
# IMPORTANT: this MUST be a separate database from `.env` - test:setup runs
# `prisma migrate reset --force` which DROPS ALL DATA.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transport_reservations_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/transport_reservations_test?schema=public"

# Mirror the AUTH_SECRET in `.env` (or use any 32+ char random string).
AUTH_SECRET="dev-test-secret-please-replace-with-real-value-min-32-chars"

# Base URL used by playwright + the apiFetch test helper.
TEST_BASE_URL="http://localhost:3000"
