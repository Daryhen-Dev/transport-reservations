generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Lookup tables ────────────────────────────────────────────────────────────

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rol")
}

model DocumentType {
  id            String        @id @default(cuid())
  name          String        @unique
  proveedores   Proveedor[]
  passengers    Passenger[]
  destinatarios Destinatario[]
  crewMembers   CrewMember[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("tipo_documento")
}

model ReservationStatus {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  passengerReservations PassengerReservation[]
  cargoReservations     CargoReservation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("estado_reserva")
}

model ProveedorType {
  id          String      @id @default(cuid())
  name        String      @unique
  proveedores Proveedor[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("tipo_proveedor")
}

// ─── Entidades principales ────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  users     User[]
  routes    Route[]
  trips     Trip[]
  cargoReservationsAsDestination CargoReservation[] @relation("DestinationBranch")
  receivedManifests              TripManifest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Audit
  createdById String?
  createdBy   User?    @relation("BranchCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("BranchUpdatedBy", fields: [updatedById], references: [id])

  @@map("sucursal")
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  roleId   String
  role     Role    @relation(fields: [roleId], references: [id])

  // OWNER         → branchId null
  // SUCURSAL_USER → branchId required (enforced in app layer + Zod)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit — who created this user (self-relation, optional)
  createdById   String?
  createdBy     User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  usersCreated  User[]   @relation("UserCreatedBy")

  // Audit inverse relations — generated for the createdBy/updatedBy fields
  // on operational entities. We never read these directly; Prisma requires
  // the inverse side declared for named relations.
  branchesCreated              Branch[]               @relation("BranchCreatedBy")
  branchesUpdated              Branch[]               @relation("BranchUpdatedBy")
  routesCreated                Route[]                @relation("RouteCreatedBy")
  routesUpdated                Route[]                @relation("RouteUpdatedBy")
  tripSchedulesCreated         TripSchedule[]         @relation("TripScheduleCreatedBy")
  tripSchedulesUpdated         TripSchedule[]         @relation("TripScheduleUpdatedBy")
  tripsCreated                 Trip[]                 @relation("TripCreatedBy")
  tripsUpdated                 Trip[]                 @relation("TripUpdatedBy")
  tripManifestsCreated         TripManifest[]         @relation("TripManifestCreatedBy")
  passengerReservationsCreated PassengerReservation[] @relation("PassengerReservationCreatedBy")
  passengerReservationsUpdated PassengerReservation[] @relation("PassengerReservationUpdatedBy")
  cargoReservationsCreated     CargoReservation[]     @relation("CargoReservationCreatedBy")
  cargoReservationsUpdated     CargoReservation[]     @relation("CargoReservationUpdatedBy")

  @@map("usuario")
}

model Country {
  id          String      @id @default(cuid())
  name        String      @unique
  nationality String
  code        String?     @unique
  proveedores Proveedor[]
  passengers  Passenger[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("pais")
}

model Route {
  id          String        @id @default(cuid())
  origin      String
  destination String
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  trips       Trip[]
  schedules   TripSchedule[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  // Audit
  createdById String?
  createdBy   User?         @relation("RouteCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?         @relation("RouteUpdatedBy", fields: [updatedById], references: [id])

  @@map("ruta")
}

model TripSchedule {
  id        String   @id @default(cuid())
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  time      String   // "HH:MM" — naive local time, e.g. "07:00"
  isActive  Boolean  @default(true)
  trips     Trip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Audit
  createdById String?
  createdBy   User?    @relation("TripScheduleCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("TripScheduleUpdatedBy", fields: [updatedById], references: [id])

  @@unique([routeId, time])
  @@map("horario_viaje")
}

model TripStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  trips     Trip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("estado_viaje")
}

model Trip {
  id                    String                 @id @default(cuid())
  departureAt           DateTime
  routeId               String
  route                 Route                  @relation(fields: [routeId], references: [id])
  branchId              String
  branch                Branch                 @relation(fields: [branchId], references: [id])
  scheduleId            String?
  schedule              TripSchedule?          @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  statusId              String
  status                TripStatus             @relation(fields: [statusId], references: [id])
  passengerReservations PassengerReservation[]
  cargoReservations     CargoReservation[]
  crew                  TripCrew[]
  manifest              TripManifest?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  // Audit
  createdById           String?
  createdBy             User?                  @relation("TripCreatedBy", fields: [createdById], references: [id])
  updatedById           String?
  updatedBy             User?                  @relation("TripUpdatedBy", fields: [updatedById], references: [id])

  @@map("viaje")
}

model TripManifest {
  id                 String    @id @default(cuid())
  code               String    @unique
  tripId             String    @unique
  trip               Trip      @relation(fields: [tripId], references: [id])
  receivedByBranchId String?
  receivedByBranch   Branch?   @relation(fields: [receivedByBranchId], references: [id])
  receivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Audit — only createdBy (manifests are immutable once generated)
  createdById        String?
  createdBy          User?     @relation("TripManifestCreatedBy", fields: [createdById], references: [id])

  @@map("manifiesto_viaje")
}

model Proveedor {
  id               String        @id @default(cuid())
  proveedorTypeId  String
  proveedorType    ProveedorType @relation(fields: [proveedorTypeId], references: [id])

  // PERSONA
  firstName      String?
  lastName       String?
  documentTypeId String?
  documentType   DocumentType? @relation(fields: [documentTypeId], references: [id])
  documentNumber String?
  birthDate      DateTime?
  countryId      String?
  country        Country?      @relation(fields: [countryId], references: [id])

  // EMPRESA
  companyName String?
  taxId       String?
  contactName String?
  phone       String?

  passengerReservations PassengerReservation[]
  cargoReservations     CargoReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("proveedor")
}

model PassengerReservation {
  id                  String                 @id @default(cuid())
  tripId              String
  trip                Trip                   @relation(fields: [tripId], references: [id])
  proveedorId         String
  proveedor           Proveedor              @relation(fields: [proveedorId], references: [id])
  seatCount           Int
  reservationStatusId String
  reservationStatus   ReservationStatus      @relation(fields: [reservationStatusId], references: [id])
  passengers          ReservationPassenger[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  // Audit
  createdById         String?
  createdBy           User?                  @relation("PassengerReservationCreatedBy", fields: [createdById], references: [id])
  updatedById         String?
  updatedBy           User?                  @relation("PassengerReservationUpdatedBy", fields: [updatedById], references: [id])

  @@map("reserva_pasajero")
}

model ReservationPassenger {
  reservationId String
  passengerId   String
  reservation   PassengerReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  passenger     Passenger            @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@id([reservationId, passengerId])
  @@map("pasajero_en_reserva")
}

model Passenger {
  id             String                 @id @default(cuid())
  firstName      String
  lastName       String
  documentTypeId String
  documentType   DocumentType           @relation(fields: [documentTypeId], references: [id])
  documentNumber String
  birthDate      DateTime?
  phone          String?
  countryId      String
  country        Country                @relation(fields: [countryId], references: [id])
  reservations   ReservationPassenger[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([documentTypeId, documentNumber])
  @@map("pasajero")
}

model CargaCategoria {
  id                String             @id @default(cuid())
  name              String             @unique
  cargoReservations CargoReservation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("carga_categoria")
}

model CargoStatus {
  id                String             @id @default(cuid())
  name              String             @unique
  cargoReservations CargoReservation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("estado_encomienda")
}

model Destinatario {
  id                String             @id @default(cuid())
  firstName         String
  lastName          String
  phone             String?
  documentTypeId    String?
  documentType      DocumentType?      @relation(fields: [documentTypeId], references: [id])
  documentNumber    String?
  cargoReservations CargoReservation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("destinatario")
}

model CargoReservation {
  id                  String            @id @default(cuid())
  tripId              String
  trip                Trip              @relation(fields: [tripId], references: [id])
  proveedorId         String
  proveedor           Proveedor         @relation(fields: [proveedorId], references: [id])
  categoriaId         String?
  categoria           CargaCategoria?   @relation(fields: [categoriaId], references: [id])
  destinatarioId      String?
  destinatario        Destinatario?     @relation(fields: [destinatarioId], references: [id])
  description         String?
  weightKg            Float
  // Destino
  destinationBranchId String?
  destinationBranch   Branch?           @relation("DestinationBranch", fields: [destinationBranchId], references: [id])
  externalDestination String?
  // Dimensiones opcionales
  diameterCm          Float?
  widthCm             Float?
  heightCm            Float?
  lengthCm            Float?
  reservationStatusId String
  reservationStatus   ReservationStatus @relation(fields: [reservationStatusId], references: [id])
  cargoStatusId       String?
  cargoStatus         CargoStatus?      @relation(fields: [cargoStatusId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  // Audit
  createdById         String?
  createdBy           User?             @relation("CargoReservationCreatedBy", fields: [createdById], references: [id])
  updatedById         String?
  updatedBy           User?             @relation("CargoReservationUpdatedBy", fields: [updatedById], references: [id])

  @@map("reserva_encomienda")
}

// ─── Tripulación ──────────────────────────────────────────────────────────────

model CrewMember {
  id             String      @id @default(cuid())
  firstName      String
  lastName       String
  phone          String?
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  documentNumber String
  birthDate      DateTime?
  trips          TripCrew[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([documentTypeId, documentNumber])
  @@map("tripulante")
}

model CrewRole {
  id        String     @id @default(cuid())
  name      String     @unique
  tripCrew  TripCrew[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("rol_tripulacion")
}

model TripCrew {
  tripId       String
  crewMemberId String
  crewRoleId   String
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  crewRole     CrewRole   @relation(fields: [crewRoleId], references: [id])
  assignedAt   DateTime   @default(now())

  @@id([tripId, crewMemberId])
  @@unique([tripId, crewRoleId])
  @@map("viaje_tripulante")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_token")
}
